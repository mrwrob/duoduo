{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuoDuo course v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "lessons"],
  "properties": {
    "schemaVersion": {"const": 1, "default": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 150},
    "description": {"type": "string", "maxLength": 2000},
    "subject": {"enum": ["language", "programming"], "default": "language"},
    "lessons": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/lesson"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
    "lesson": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "exercises"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 150},
        "exercises": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/exercise"}}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 500}}
    },
    "exercise": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "prompt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["choice", "word_input", "sentence_input", "sentence_bank", "sentence_select", "sentence_order", "image_input", "image_choice"]},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 2000},
        "template": {"type": "string", "maxLength": 4000},
        "explanation": {"type": "string", "maxLength": 2000},
        "options": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/option"}},
        "correctOptionIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "answers": {"type": "array", "maxItems": 12, "items": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}},
        "multiple": {"type": "boolean", "default": false},
        "imageBase64": {"type": ["string", "null"], "contentEncoding": "base64", "maxLength": 2800000},
        "imageAlt": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "answerPolicy": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "allowTypos": {"type": "boolean", "default": true},
            "caseSensitive": {"type": "boolean", "default": false},
            "trim": {"type": "boolean", "default": true}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["word_input", "sentence_input", "image_input"]}}},
          "then": {"required": ["answers"], "properties": {"answers": {"minItems": 1}, "options": {"maxItems": 0}, "correctOptionIds": {"maxItems": 0}, "multiple": {"const": false}}},
          "else": {"required": ["options", "correctOptionIds"], "properties": {"options": {"minItems": 2}, "correctOptionIds": {"minItems": 1}, "answers": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["word_input", "image_input"]}}},
          "then": {"properties": {"answers": {"maxItems": 1}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["sentence_input", "sentence_bank"]}}},
          "then": {"required": ["template"], "properties": {"template": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["image_input", "image_choice"]}}},
          "then": {"required": ["imageBase64", "imageAlt"], "properties": {"imageBase64": {"type": "string", "minLength": 1}, "imageAlt": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"imageBase64": {"type": "null"}, "imageAlt": {"type": "null"}}}
        }
      ]
    }
  }
}
