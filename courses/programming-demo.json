{
  "schemaVersion": 1,
  "id": "python-demo",
  "version": 1,
  "title": "Pierwsze kroki w Pythonie",
  "description": "Kurs demonstracyjny · poznaj słowa i składnię kodu.",
  "subject": "programming",
  "lessons": [
    {
      "id": "basics",
      "title": "Czytamy kod",
      "exercises": [
        {
          "id": "boolean",
          "type": "choice",
          "prompt": "Które zapisy są wartościami logicznymi w Pythonie?",
          "multiple": true,
          "options": [
            {
              "id": "o1",
              "text": "True"
            },
            {
              "id": "o2",
              "text": "False"
            },
            {
              "id": "o3",
              "text": "true"
            },
            {
              "id": "o4",
              "text": "false"
            }
          ],
          "correctOptionIds": [
            "o1",
            "o2"
          ],
          "explanation": "Python rozróżnia wielkie i małe litery."
        },
        {
          "id": "print",
          "type": "word_input",
          "prompt": "Wpisz nazwę funkcji wypisującej tekst.",
          "template": "{{1}}(\"Hello\")",
          "answers": [
            [
              "print"
            ]
          ],
          "answerPolicy": {
            "allowTypos": false,
            "caseSensitive": true,
            "trim": true
          }
        },
        {
          "id": "condition",
          "type": "sentence_input",
          "prompt": "Uzupełnij warunek i funkcję wypisującą tekst.",
          "template": "{{1}} ready:\n    {{2}}(\"Hello\")",
          "answers": [
            [
              "if"
            ],
            [
              "print"
            ]
          ],
          "answerPolicy": {
            "allowTypos": false,
            "caseSensitive": true,
            "trim": true
          }
        },
        {
          "id": "loop",
          "type": "sentence_bank",
          "prompt": "Uzupełnij pętlę liczącą od 0 do 2.",
          "template": "{{1}} i in {{2}}(3):\n    print(i)",
          "options": [
            {
              "id": "o1",
              "text": "for"
            },
            {
              "id": "o2",
              "text": "range"
            },
            {
              "id": "o3",
              "text": "if"
            },
            {
              "id": "o4",
              "text": "return"
            }
          ],
          "correctOptionIds": [
            "o1",
            "o2"
          ]
        },
        {
          "id": "keywords",
          "type": "sentence_select",
          "prompt": "Zaznacz słowa kluczowe Pythona.",
          "options": [
            {
              "id": "o1",
              "text": "if"
            },
            {
              "id": "o2",
              "text": "ready"
            },
            {
              "id": "o3",
              "text": "and"
            },
            {
              "id": "o4",
              "text": "active"
            },
            {
              "id": "o5",
              "text": ":"
            }
          ],
          "correctOptionIds": [
            "o1",
            "o3"
          ]
        },
        {
          "id": "assignment",
          "type": "sentence_order",
          "prompt": "Ułóż przypisanie wartości 3 do zmiennej count.",
          "options": [
            {
              "id": "o1",
              "text": "count"
            },
            {
              "id": "o2",
              "text": "="
            },
            {
              "id": "o3",
              "text": "3"
            }
          ],
          "correctOptionIds": [
            "o1",
            "o2",
            "o3"
          ]
        },
        {
          "id": "output-input",
          "type": "image_input",
          "prompt": "Przepisz wynik programu widoczny po znaku >.",
          "imageBase64": "",
          "imageAlt": "Okno konsoli z wynikiem Hello po znaku zachęty.",
          "answers": [
            [
              "Hello"
            ]
          ],
          "answerPolicy": {
            "allowTypos": false,
            "caseSensitive": true,
            "trim": true
          }
        },
        {
          "id": "output-choice",
          "type": "image_choice",
          "prompt": "Który kod wypisze tekst pokazany w konsoli?",
          "imageBase64": "",
          "imageAlt": "Okno konsoli pokazujące tekst Hello.",
          "options": [
            {
              "id": "o1",
              "text": "print(\"Hello\")"
            },
            {
              "id": "o2",
              "text": "print(\"hello\")"
            },
            {
              "id": "o3",
              "text": "input(\"Hi\")"
            }
          ],
          "correctOptionIds": [
            "o1"
          ]
        }
      ]
    }
  ]
}
