{
  "schemaVersion": 1,
  "id": "english-demo",
  "version": 1,
  "title": "Angielski na dobry początek",
  "description": "Kurs demonstracyjny · słowa, zdania i małe odkrycia.",
  "subject": "language",
  "lessons": [
    {
      "id": "first-steps",
      "title": "Pierwsze kroki",
      "exercises": [
        {
          "id": "fruit",
          "type": "choice",
          "prompt": "Które słowa oznaczają owoce?",
          "multiple": true,
          "options": [
            {
              "id": "o1",
              "text": "apple"
            },
            {
              "id": "o2",
              "text": "table"
            },
            {
              "id": "o3",
              "text": "banana"
            },
            {
              "id": "o4",
              "text": "window"
            }
          ],
          "correctOptionIds": [
            "o1",
            "o3"
          ],
          "explanation": "Apple to jabłko, a banana to banan."
        },
        {
          "id": "water",
          "type": "word_input",
          "prompt": "Uzupełnij zdanie słowem „woda”.",
          "template": "I drink {{1}}.",
          "answers": [
            [
              "water"
            ]
          ],
          "answerPolicy": {
            "allowTypos": true,
            "caseSensitive": false,
            "trim": true
          }
        },
        {
          "id": "sentence",
          "type": "sentence_input",
          "prompt": "Uzupełnij: „Ona ma czerwony rower”.",
          "template": "She {{1}} a {{2}} bike.",
          "answers": [
            [
              "has"
            ],
            [
              "red"
            ]
          ],
          "answerPolicy": {
            "allowTypos": true,
            "caseSensitive": false,
            "trim": true
          }
        },
        {
          "id": "bank",
          "type": "sentence_bank",
          "prompt": "Uzupełnij: „Lubię czytać książki”.",
